# Safe for the static browser bundle. Never place a Secret Key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Edge Function secrets are configured in Supabase Dashboard, not in this file:
# APP_SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.example
# RATE_LIMIT_SALT=generate-a-long-random-value

# FAQ assistant Edge Function secrets. Keep the feature disabled until the
# migration, model access, rate limiting, CORS and staging behavior are verified.
# GEMINI_API_KEY=configure-in-supabase-secrets
# GEMINI_MODEL=confirm-with-your-google-ai-project
# Current official stable candidate (verify project access before use): gemini-3.5-flash-lite
# FAQ_ASSISTANT_ENABLED=false
# FAQ_ASSISTANT_TIMEOUT_MS=8000
# FAQ_ASSISTANT_RATE_LIMIT=10
# FAQ_ASSISTANT_DAILY_LIMIT=50
